from typing import Any

import torch

class LowVramPatch:
    def __init__(self, key: str, patches: dict[str, list], convert_func: Any = None, set_func: Any = None) -> None: ...
    def __call__(self, weight: torch.Tensor) -> torch.Tensor: ...

class ModelPatcher:
    patches: dict[str, list]
    def __init__(
        self, model: torch.nn.Module, load_device: Any = None, offload_device: Any = None, size: int = 0, weight_inplace_update: bool = False, fast_disk: Any = None
    ) -> None: ...
    def add_patches(self, patches: dict[str, Any], strength_patch: float = 1.0, strength_model: float = 1.0) -> list[str]: ...
    def patch_weight_to_device(self, key: str, device_to: Any = None, inplace_update: bool = False, return_weight: bool = False, force_cast: bool = False) -> None: ...
    def unpatch_model(self, device_to: Any = None, unpatch_weights: bool = True) -> None: ...
